# Create an EU PostHog Cloud project, then add these values in Vercel for
# Production and Preview. Behavior analytics stays disabled until both the token
# and the verified privacy-ready flag are present.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_replace_with_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Set true only after raw-IP discard and <=30-day replay retention are verified.
NEXT_PUBLIC_POSTHOG_PRIVACY_READY=false
