# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# screenshot tests
/Website_Screenshots/
/Priyanshu_Profile_For_Research/
/temp_*.png

# Local AI workspaces and browser automation output
/.claude/
/.opencode/
/.playwright-mcp/
/.sisyphus/

# Internal root-level notes; keep the public project README
/*.md
!/README.md
